<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "app": the app executable, uploaded by the release workflow as a
  GitHub Actions artifact (a zip holding VersePreflight.exe). Paste into SignPath under
  Project > Artifact configurations, with the slug "app".
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="VersePreflight.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
