<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installer": the Velopack installer built by the release workflow from
  the already signed app, uploaded as a GitHub Actions artifact (a zip holding the Setup.exe). Paste into
  SignPath under Project > Artifact configurations, with the slug "installer".
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="VersePreflight-win-Setup.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
