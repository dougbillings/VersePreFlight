<?xml version="1.0" encoding="utf-8"?>
<!-- Release build for Windows: one self-contained, trimmed exe (no .NET install needed).
     dotnet publish src/VersePreflight.App -p:PublishProfile=win-x64 -p:Version=X.Y.Z -o publish -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Trimming cuts the exe from ~99 MB to ~41 MB; the app uses compiled bindings and source-generated JSON -->
    <PublishTrimmed>true</PublishTrimmed>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
