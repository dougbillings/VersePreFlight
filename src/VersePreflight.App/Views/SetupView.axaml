<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VersePreflight.App.ViewModels"
             xmlns:c="using:VersePreflight.App.Controls"
             xmlns:t="using:VersePreflight.App.Theme"
             x:Class="VersePreflight.App.Views.SetupView"
             x:DataType="vm:SetupViewModel">
    <!-- Two columns so the whole form fits a 1280x720 handheld screen without scrolling -->
    <c:HudFrame Classes="panel" MaxWidth="1120" Padding="26,20">
        <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,28,*">
            <TextBlock Grid.ColumnSpan="3" Classes="section" Text="{Binding Title}" Margin="0,0,0,14" />

            <!-- Left: notice and folders -->
            <StackPanel Grid.Row="1" Spacing="14">
                <!-- First run: the fan-project notice must be read and acknowledged -->
                <c:HudFrame Cut="8" Stroke="{x:Static t:Hud.WarnBrush}" Padding="14,10" IsVisible="{Binding IsFirstRun}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Disclaimer}" TextWrapping="Wrap" />
                        <TextBlock Classes="dim" FontSize="12" Text="{Binding TrademarkNotice}" TextWrapping="Wrap" />
                        <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap"
                                   Text="Verse Preflight changes folders in your game install (folder links, caches and, if enabled, StarStrings). It never modifies the game's executables or Data.p4k." />
                        <CheckBox IsChecked="{Binding DisclaimerAccepted}" Content="I understand this is an unofficial, fan-made tool." />
                    </StackPanel>
                </c:HudFrame>

                <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="GAME FOLDER  ·  CONTAINS LIVE / PTU" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBox Text="{Binding GameBase}" PlaceholderText="...\Roberts Space Industries\StarCitizen" />
                        <Button Grid.Column="1" Classes="hud" Content="BROWSE" Command="{Binding BrowseGameBaseCommand}" />
                    </Grid>
                    <TextBlock Classes="mono" Text="{Binding GameBaseHint}" Foreground="{Binding GameBaseHintBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="LINK FOLDER" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBox Text="{Binding LinkRoot}" />
                        <Button Grid.Column="1" Classes="hud" Content="BROWSE" Command="{Binding BrowseLinkRootCommand}" />
                    </Grid>
                    <TextBlock Classes="mono dim" Text="{Binding LinkRootHint}" TextWrapping="Wrap" />
                    <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap"
                               Text="Where your linked folders are kept. A cloud-synced folder shares them between PCs." />
                </StackPanel>
            </StackPanel>

            <!-- Right: what to link and optional StarStrings -->
            <StackPanel Grid.Row="1" Grid.Column="2" Spacing="14">
                <StackPanel Spacing="2">
                    <TextBlock Classes="label" Text="FOLDERS TO LINK" />
                    <ItemsControl ItemsSource="{Binding Links}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LinkToggleViewModel">
                                <CheckBox IsChecked="{Binding Enabled}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Classes="mono dim" FontSize="11" Text="{Binding SourceSubPath}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- StarStrings: opt-in third-party content -->
                <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="STARSTRINGS  ·  OPTIONAL" />
                    <TextBlock Classes="dim" FontSize="12" Text="{Binding StarStringsCredit}" TextWrapping="Wrap" />
                    <CheckBox IsChecked="{Binding StarStringsEnabled}" Content="Install and update StarStrings" />
                    <CheckBox IsChecked="{Binding StarStringsIncludePtu}" IsEnabled="{Binding StarStringsEnabled}"
                              Content="Also on PTU (often lags new builds)" />
                    <Button Classes="hud small" Content="VIEW ON GITHUB" Command="{Binding OpenStarStringsCommand}"
                            HorizontalAlignment="Left" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="UPDATES" />
                    <CheckBox IsChecked="{Binding CheckForUpdates}" Content="Check GitHub for new versions at startup" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="10"
                        HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Classes="hud" Content="CANCEL" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" MinWidth="120" />
                <Button Classes="hud primary" Content="SAVE" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}"
                        MinWidth="180" MinHeight="46" FontSize="14" />
            </StackPanel>
        </Grid>
    </c:HudFrame>
</UserControl>
