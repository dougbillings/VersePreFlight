<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VersePreflight.App.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#3FD8F2" RegionColor="#0B121C" ErrorText="#FF5C6C" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="/Theme/HudStyles.axaml" />
    </Application.Styles>
</Application>
